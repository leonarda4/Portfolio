{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.leonardalovric.com" }],
      "destination": "https://leonardalovric.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/optimized/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
